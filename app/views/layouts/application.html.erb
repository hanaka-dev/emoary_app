<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%=  full_title(yield(:title)) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <%= javascript_importmap_tags %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  </head>

  <body class="bg-green-50 min-h-full">
    <main class="container mx-auto my-auto">
      <div class="flex flex-col min-h-full">
        <% flash.each do |type, message| %>
          <% css =
              case type.to_sym
              when :success
                "bg-blue-100 border border-blue-400 font-bold text-center text-blue-700 mx-auto justify-center w-1/2"
              when :alert, :danger, :error
                "bg-red-100 border border-red-400 font-bold text-center text-red-700 mx-auto justify-center w-1/2"
              else
                "bg-yellow-100 border border-yellow-400 font-bold text-center text-yellow-700 mx-auto justify-center w-1/2"
              end %>

          <div class="rounded px-4 py-3 mb-4 <%= css %>">
            <%= message %>
          </div>
        <% end %>
        <%= yield %>
      </div>
      <%= debug(params) if Rails.env.development? %>
    </main>
  </body>

</html>


