<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%=  full_title(yield(:title)) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% if respond_to?(:logged_in?) && logged_in? && current_user.demo_account? %>
      <meta name="emoary-demo-tab-purge-url" content="<%= demo_purge_extras_path %>">
    <% end %>
    
    <%= javascript_importmap_tags %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  </head>

  <body class="bg-green-50 min-h-screen flex flex-col">
    <main class="container mx-auto flex flex-1 flex-col min-h-0 w-full max-w-full">
      <%# フラッシュは上固定。メインコンテンツは残り高さで縦方向センター（短い画面で上下に余白）。長いコンテンツはスクロール。 %>
      <div class="shrink-0 w-full">
        <% flash.each do |type, message| %>
          <% css =
              case type.to_sym
              when :success
                "bg-blue-100 border border-blue-400 font-bold text-center text-blue-700 mx-auto justify-center w-1/2"
              when :alert, :danger, :error
                "bg-red-100 border border-red-400 font-bold text-center text-red-700 mx-auto justify-center w-1/2"
              else
                "bg-yellow-100 border border-yellow-400 font-bold text-center text-yellow-700 mx-auto justify-center w-1/2"
              end %>

          <div class="rounded px-4 py-3 mb-4 <%= css %>">
            <%= message %>
          </div>
        <% end %>
      </div>
      <div class="flex flex-1 flex-col min-h-0 w-full overflow-y-auto">
        <div class="w-full max-w-full shrink-0 my-auto">
          <%= yield %>
        </div>
      </div>
    </main>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/2.1.3/TweenMax.min.js"></script>
    <script src="/wavify.js"></script>
  </body>

</html>


