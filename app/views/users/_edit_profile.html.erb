<!-- 編集モード: -->
<div class="min-h-screen mx-auto my-auto flex flex-col items-center justify-center w-full">
    <div class="  bg-white rounded-lg shadow-md  max-w-xl  items-stretch w-full">
        <!--上二つの戻る、ヘルプアイコン-->
        <div class="flex justify-between">
            <div class="ml-2 mt-2">
                <%= link_to home_path, class: "inline-block" do %>
                <%= heroicon "arrow-left",
                                variant: :outline,
                                options: { width: 48, height: 48, class: "text-gray-500" } %>
                <% end %>   
            </div>
            <div>
                <%= link_to help_path, class: "inline-block" do %>
                    <%= heroicon "question-mark-circle",
                                variant: :outline,
                                options: { width: 48, height: 48, class: "stroke-gray-500" } %>
                <% end %>   
            </div>
        </div>
        <!--フォーム内容-->
        <%= form_with model: @user, url: settings_path, method: :patch, class: "mx-auto my-auto w-full" do |f|%>
            <div class="w-full justify-center">
                <h1 class="text-4xl font-semibold text-black text-center my-4">Profile</h1>
                <div class="border-b border-gray-900/10 p-12 justify-center flex justify-items-center mb-6">
                    <%= gravatar_for @user %>
                </div>
                
                <div class="border-b border-gray-900/10 pb-12 justify-items-center ">
                    <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 items-stretch mx-auto w-1/2">
                        <%= render 'shared/error_messages', object: @user %>
                        <div class="w-full ">
                            <%= f.label :name, "Name", class: "block text-sm/6 font-medium text-gray-900" %>
                            <div class="mt-2">
                                <%= f.text_field :name, class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 border border-gray-300 placeholder:text-gray-400 focus:border-indigo-600 focus:ring-indigo-600 sm:text-sm", required: true %>
                            </div>
                        </div>

                        <div class="w-full">
                            <%= f.label :email, "Email address", class: "block text-sm/6 font-medium text-gray-900" %>
                            <div class="mt-2">
                                <%= f.email_field :email, class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 border border-gray-300 placeholder:text-gray-400 focus:border-indigo-600 focus:ring-indigo-600 sm:text-sm", required: true %>
                            </div>
                        </div>

                        <% user_country = (@user.try(:country) || "us") %>
                        <div class="w-full">
                            <label for="country" class="block text-sm font-medium text-gray-900">Country</label>
                            <div class="mt-2">
                                <select id="country" disabled
                                        class="block w-full rounded-md bg-gray-100 py-1.5 pl-3 pr-8 text-base text-gray-900 border border-gray-300 sm:text-sm">
                                    <option value="us" selected>United States</option>
                                    <option value="jp">Japan</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
                
            <div class="m-6 flex justify-between">
                <%= f.submit "Save", class:  "text-white text-center bg-blue-700 w-1/4 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800 ml-30"%>
                <%= link_to "Cancel", settings_path, class: "text-white text-center bg-red-700 w-1/4 hover:bg-red-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800 mr-30"%>
            </div>
        <% end %>
    </div>
</div>