<%= form_with(url: login_path, scope: :session, class: "w-full") do |f|%>
    <div class="mb-5">
        <%= f.label :email, "Your email", class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
        <%= f.email_field :email, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500", placeholder: "nogi564@bangban.uk", required: true %>
    </div>
    <div class="mb-5">
        <div class="flex items-center justify-between">
            <%= f.label :password, class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
            <%= link_to "(forgot password)", new_password_reset_path, class:"underline text-blue-900"%>
        </div>   
        <%= f.password_field :password, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500", placeholder: "foobar", required: true %> 
    </div>
    <div class="flex items-start mb-5">
        <div class="flex items-center h-5">
            <%= f.check_box :remember_me, class: "w-4 h-4 border border-gray-300 rounded-sm  focus:ring-3 focus:ring-blue-300 dark:bg-gray-700 dark:border-gray-600 dark:focus:ring-blue-600 dark:ring-offset-gray-800 dark:focus:ring-offset-gray-800"%>
            <%= f.label :remember_me, "Remember me", class: "ms-2 text-sm font-medium text-gray-900 dark:text-gray-300" %>     
        </div>
    </div>


    <%= f.submit yield(:button_text), class: "text-white bg-black hover:bg-black focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm w-full  px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800 block w-full"%>
<% end %>

<div class="mt-4">
  <%= button_to "Use a demo account", demo_login_path, method: :post,
        class: "text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-200 font-medium rounded-lg text-sm w-full px-5 py-2.5 text-center" %>
</div>

<p class="m-2">New user? &nbsp;&nbsp;&nbsp; <%= link_to "Sign up now!", signup_path, class: "underline text-blue-900 font-bold" %></p>



