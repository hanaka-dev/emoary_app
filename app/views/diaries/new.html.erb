<% provide(:title, "Diary") %>
<% provide(:button_text, "Submit") %>

<div id="diary-viewport-fit" class="diary-viewport-fit">
<div id="diary-page-scalable" class="diary-page-scalable">
<div class="min-h-screen">
<!--上二つの戻る、ヘルプアイコン-->
<div class="flex justify-between">
    <div class="ml-2 mt-2">
        <%= link_to home_path, class: "inline-block" do %>
        <%= heroicon "arrow-left",
                        variant: :outline,
                        options: { width: 48, height: 48, class: "text-gray-500" } %>
        <% end %>
    </div>
    <div>
        <%= link_to help_path, class: "inline-block" do %>
            <%= heroicon "question-mark-circle",
                        variant: :outline,
                        options: { width: 48, height: 48, class: "stroke-gray-500" } %>
        <% end %>
    </div>

</div>
<div class="flex min-h-screen w-full h-full">
    <div class="flex-1 flex flex-col items-center justify-center w-full self-start pt-36 pb-18">
        <div class="w-full flex justify-center">
        <%= render "diary_leaf" %>
        </div>
        <%# 葉の下: 不正データ時のバリデーションメッセージ（表示時のみ表示） %>
        <div id="validation-message-wrap" class="validation-message-wrap hidden mt-10 mx-4" role="alert" aria-live="polite">
          <div id="validation-message-box" class="validation-message-box">
            <p id="validation-message-text" class="validation-message-text text-center text-gray-900 mb-4"></p>
            <div class="flex justify-center">
              <button type="button" id="validation-message-ok" class="validation-message-ok rounded-lg px-3 py-1.5 text-xs font-medium text-white focus:ring-2 focus:outline-none focus:ring-green-300">OK</button>
            </div>
          </div>
        </div>
    </div>
    <div class="flex-1 flex m-2 w-full min-h-[50vh] border border-gray-600 box-shadow-md bg-gray-100 rounded-3xl p-20">
        <%= render "diary_form"%>
    </div>
</div>
</div>
</div>
<script>
(function() {
  function fitDiaryToViewport() {
    var fit = document.getElementById("diary-viewport-fit");
    var scalable = document.getElementById("diary-page-scalable");
    if (!fit || !scalable) return;
    scalable.style.position = "";
    scalable.style.transform = "";
    scalable.style.transformOrigin = "";
    fit.style.height = "";
    var r = scalable.getBoundingClientRect();
    var contentH = scalable.scrollHeight;
    var contentW = scalable.scrollWidth || scalable.offsetWidth;
    var vh = window.innerHeight;
    var vw = window.innerWidth;
    var buffer = 16;
    var scale = Math.min(1, (vh - buffer) / contentH, (vw - buffer) / contentW);
    fit.style.height = vh + "px";
    fit.style.overflow = "hidden";
    scalable.style.position = "absolute";
    scalable.style.top = "0";
    scalable.style.left = "0";
    scalable.style.width = "100%";
    scalable.style.height = contentH + "px";
    scalable.style.transformOrigin = "top center";
    scalable.style.transform = "scale(" + scale + ")";
  }
  function scheduleFit() {
    setTimeout(fitDiaryToViewport, 0);
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", function() {
      scheduleFit();
      var scalable = document.getElementById("diary-page-scalable");
      if (scalable && typeof ResizeObserver !== "undefined") {
        var ro = new ResizeObserver(function() { scheduleFit(); });
        ro.observe(scalable);
      }
    });
  } else {
    scheduleFit();
  }
  window.addEventListener("resize", fitDiaryToViewport);
  window.fitDiaryToViewport = fitDiaryToViewport;
})();
</script>
