<% provide(:title, "Confirm Diary") %>
<%
  back_diary = {
    emo_1: @diary.emo_1,
    emo_2: @diary.emo_2,
    emo_3: @diary.emo_3,
    rate_1: @diary.rate_1,
    rate_2: @diary.rate_2,
    rate_3: @diary.rate_3,
    content: @diary.content
  }
%>

<%# 葉・フォーム: 横は max-w-2xl。←・? は日記ページ（new）と同じ justify-between + ml-2 mt-2。 %>
<div class="w-full max-w-2xl mx-auto px-4 sm:px-5 flex flex-col py-4 sm:py-6 box-border">
  <div class="flex justify-between shrink-0">
    <div class="ml-2 mt-2">
      <%= link_to new_diary_path(diary: back_diary), class: "inline-block" do %>
        <%= heroicon "arrow-left",
                     variant: :outline,
                     options: { width: 48, height: 48, class: "text-gray-500" } %>
      <% end %>
    </div>
    <div>
      <%= link_to help_path, class: "inline-block" do %>
        <%= heroicon "question-mark-circle",
                     variant: :outline,
                     options: { width: 48, height: 48, class: "stroke-gray-500" } %>
      <% end %>
    </div>
  </div>
  <div class="w-full flex justify-center">
    <div class="confirm-leaf-scale w-full flex justify-center">
      <%= render "diary_leaf" %>
    </div>
  </div>

  <div class="w-full mt-2">
    <div class="bg-white rounded-3xl border border-gray-200 shadow-md px-4 py-6 sm:px-8 sm:py-8 mx-auto w-full max-w-full">
      <%= render "diary_form", readonly: true %>
    </div>
  </div>

  <%= render "diary_save_modal" %>
  <%= javascript_include_tag "diary_confirm_save", type: "module" %>
</div>
