
<%= form_with(model: @diary, url: confirm_diaries_path, class: "w-full") do |f| %>
  <%= render "shared/error_messages", object: f.object %>

  <%# 隠しフィールド（選択された感情IDと割合をサーバーに送る） %>
  <%= f.hidden_field :emo_1, id: "diary_emo_1" %>
  <%= f.hidden_field :emo_2, id: "diary_emo_2" %>
  <%= f.hidden_field :emo_3, id: "diary_emo_3" %>
  <%= f.hidden_field :rate_1, id: "diary_rate_1" %>
  <%= f.hidden_field :rate_2, id: "diary_rate_2" %>
  <%= f.hidden_field :rate_3, id: "diary_rate_3" %>

  <h1 class="text-4xl text-center mb-6 font-type">Choose your emotion !</h1>

  <div id="diary-form-root"
       class="flex flex-col w-full font-type"
       data-max-emotions="3">

    <%# 感情チップ一覧（レスポンシブ: 幅に応じて折り返し。100%で4x2、50%で2x4など） %>
    <div class="emotion-chips-container flex flex-wrap gap-x-4 gap-y-3 my-4">
      <% EMOTIONS.each do |id, data| %>
        <% key   = data[:key] || data["key"] %>
        <% color = data[:color] || data["color"] %>
        <button
          type="button"
          class="emotion-chip flex items-center justify-between gap-2 px-4 py-2 border text-base transition-all w-36 min-h-9 shrink-0"
          style="--chip-hover-color: <%= color %>"
          data-emotion-id="<%= id %>"
          data-emotion-name="<%= I18n.t("emotions.#{key}") %>"
          data-emotion-color="<%= color %>">
          <span class="chip-label-wrap flex-1 flex justify-center items-center min-w-0">
            <span class="chip-label"><%= I18n.t("emotions.#{key}") %></span>
          </span>
          <span class="chip-icon text-4xl leading-none shrink-0">+</span>
        </button>
      <% end %>
    </div>

    <%# 選択された感情ごとのスライダー行（左: チップ / 右: スライダー） %>
    <div id="emotion-sliders" class="flex flex-col gap-6 my-8">
      <% 3.times do |i| %>
        <% idx = i + 1 %>
        <div class="emotion-row flex items-center gap-4"
             style="display: none;"
             data-slot-index="<%= idx %>">
          <div class="flex items-center">
            <span class="emotion-chip-selected inline-flex items-center justify-between gap-2 px-4 py-2 border text-base w-32 min-h-9 shrink-0"
                  data-role="selected-chip">
              <span class="chip-label-wrap flex-1 flex justify-center items-center min-w-0">
                <span class="selected-chip-label"></span>
              </span>
              <button type="button"
                      class="selected-chip-remove text-4xl leading-none shrink-0"
                      aria-label="Remove emotion">
                ×
              </button>
            </span>
          </div>
          <div class="flex-1 flex items-center gap-2">
            <input type="range"
                   min="1"
                   max="100"
                   value="33"
                   class="emotion-slider w-full"
                   data-role="slider"
                   data-slot-index="<%= idx %>">
            <span class="w-10 text-right text-sm"
                  data-role="slider-value">33</span>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mb-5 flex-col my-10">
      <%= f.label :content, "Event", class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
      <%= f.text_field :content,
                       class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500",
                       placeholder: "What happens, today?" %>
    </div>
  </div>

  <div class="flex flex-col">
    <%= f.submit yield(:button_text),
                 class: "text-white bg-black hover:bg-black focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm w-full px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800 block my-2" %>
  </div>
<% end %>

<%= javascript_include_tag "diary_form" %>